# Copy this file to .env. Never commit real API keys.
#
# Model backend: openai or ollama
MODEL_PROVIDER=ollama

# For Ollama/local models. Pull the configured model before starting the app.
MODEL_NAME=qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Focused model used for the paper-specific "why it matters" agent.
PAPER_READER_AGENT_PROVIDER=ollama
PAPER_READER_AGENT_MODEL=qwen2.5:7b
PAPER_READER_AGENT_FALLBACK_MODELS=qwen2.5:3b
PAPER_READER_AGENT_KEEP_ALIVE=15m
PAPER_READER_AGENT_MAX_TOKENS=220
PAPER_READER_MATH_MAX_TOKENS=1200
PAPER_READER_MATH_MAX_ATTEMPTS=2
PAPER_READER_MATH_MODEL=qwen3.5:4b
PAPER_READER_MATH_FALLBACK_MODELS=qwen2.5:7b,qwen2.5:3b
# One targeted revise-and-rejudge pass. Set to 0 for evaluation-only behavior.
PAPER_READER_MATH_REPAIR_ATTEMPTS=1
PAPER_READER_MATH_MIN_IMPROVEMENT=0.1
PAPER_READER_JUDGE_PROVIDER=ollama
PAPER_READER_JUDGE_MODEL=qwen2.5:7b
PAPER_READER_JUDGE_FALLBACK_MODELS=qwen2.5:3b
PAPER_READER_JUDGE_MAX_TOKENS=700

# Stateful paper chat. Fast uses one routed specialist; deeper modes use bounded fan-out.
PAPER_CHAT_MAX_TOKENS=1400
PAPER_CHAT_MAX_PARALLEL=1
PAPER_CHAT_TAVILY_RESULTS=5
PAPER_CHAT_JOB_TIMEOUT=480

# Shared harness budgets across a workflow, its specialists, and repair/judge calls.
# Restart the reader after changing concurrency. This limit is per server process.
PAPER_HARNESS_LOCAL_CONCURRENCY=1
PAPER_HARNESS_MAX_OUTPUT_TOKENS=1800
PAPER_HARNESS_CHAT_MODEL_CALLS=8
PAPER_HARNESS_CHAT_SECONDS=300
PAPER_HARNESS_MATH_MODEL_CALLS=12
PAPER_HARNESS_MATH_SECONDS=480
PAPER_HARNESS_CONCEPT_MODEL_CALLS=4
PAPER_HARNESS_CONCEPT_SECONDS=180
PAPER_HARNESS_REPORT_MODEL_CALLS=64
PAPER_HARNESS_REPORT_SECONDS=1800
# Optional per-profile overrides: PAPER_HARNESS_<PROFILE>_INPUT_TOKENS / _TOOL_CALLS.
# Input-token budgets are estimates, not provider billing or context-window limits.

# Targeted Tavily Research settings for concept definitions.
TAVILY_API_KEY=
TAVILY_RESEARCH_MODEL=mini
TAVILY_RESEARCH_TIMEOUT=90
TAVILY_RESEARCH_POLL_INTERVAL=2
TAVILY_HTTP_TIMEOUT=20
OLLAMA_REQUEST_TIMEOUT=120
ENRICHMENT_JOB_TIMEOUT=240

# Optional citation-graph metadata. Local bibliography lineage works without a key.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_ALLOW_UNAUTHENTICATED=false
# Optional scholarly metadata enrichment. Crossref and casual OpenAlex use work without keys.
CROSSREF_MAILTO=
OPENALEX_API_KEY=

# Context diagnostics. The reader estimates prompt usage and probes Ollama for native capacity.
CONTEXT_DEBUG_PROBE_OLLAMA=true
CONTEXT_DEBUG_PROBE_TIMEOUT=1.0

# Papers with Code's final public methods snapshot is downloaded once and compacted locally.
PWC_VOCAB_ENABLED=true
PWC_VOCAB_ALLOW_NETWORK=true
PWC_VOCAB_CACHE_PATH=agent_memory/pwc_methods_vocabulary.json
PWC_VOCAB_DOWNLOAD_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-5.5

# Optional LLMOps. Content capture is off by default; traces contain hashes and metrics.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_CAPTURE_CONTENT=false
# Keep false so local pytest fixtures never pollute release quality metrics.
LANGFUSE_ENABLE_IN_TESTS=false
# Optional stable release name. Leave blank locally to use an automatic source fingerprint.
PAPER_READER_RELEASE=

# Backward-compatible LangSmith switches. Avoid enabling two tracing backends together.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deep-paper-agent
